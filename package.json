{
  "name": "openetl-lens",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OpenETL Lens: one small UI to look at the data in the OpenETL lab databases: PostgreSQL, MongoDB, ClickHouse, Elasticsearch, Qdrant and Relata.",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch --env-file-if-exists=.env server/index.js",
    "dev:web": "vite --config web/vite.config.js",
    "build": "vite build --config web/vite.config.js",
    "start": "node --env-file-if-exists=.env server/index.js"
  },
  "dependencies": {
    "express": "^4.21.0",
    "mongodb": "^6.10.0",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.0"
  }
}
