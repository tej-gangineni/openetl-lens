# OpenETL Lens. Defaults match the OpenETL data lab. Copy to .env to change them.
PORT=4000
PG_URL=postgresql://lab:lab@127.0.0.1:5433/openetl
MONGO_URL=mongodb://127.0.0.1:27017
MONGO_DB=openetl
CH_URL=http://127.0.0.1:8123
CH_USER=lab
CH_PASSWORD=lab
CH_DB=openetl
ES_URL=http://127.0.0.1:9200
QDRANT_URL=http://127.0.0.1:6333
RELATA_URL=http://127.0.0.1:9090
# Comma-separated Relata type names to list (default DocumentChunk).
RELATA_TYPES=DocumentChunk
# Optional API keys for secured Elasticsearch / Qdrant.
ES_API_KEY=
QDRANT_API_KEY=
# A Relata registry token (the bootstrap token does not work through Docker). Required for the Relata tab.
RELATA_TOKEN=
